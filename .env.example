# Required — exchange platform base URL (e.g. https://example.com)
BASE_URL=

# Account credentials
USERNAME=
PASSWORD=

# Optional — if set, the test asserts the portfolio value equals this exact amount
# Leave blank to only validate that the value is a valid non-negative number
EXPECTED_PORTFOLIO_VALUE=

# Optional — only required if the new-device approval gate appears during `npm run auth:save`.
# When set, the approval email is fetched automatically over Gmail IMAP instead of
# requiring you to click the link by hand. See services/GmailApprovalService.ts.
EMAIL=
# Gmail App Password (NOT your regular Gmail password) — generate one at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled).
GMAIL_APP_PASSWORD=

# Optional — only required if an authenticator-app 2FA prompt appears during `npm run auth:save`.
# When set, the current 6-digit code is generated automatically instead of requiring you to
# read it off a phone. Use the base32 secret shown when 2FA was first enabled on the account
# (not a 6-digit code — the long setup key, e.g. shown alongside the QR code). See services/TotpService.ts.
TOTP_PASSKEY=
